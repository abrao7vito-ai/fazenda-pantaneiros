# 2. Na aba "General Information", copie o "Application ID" (Client ID):
DISCORD_CLIENT_ID=SEU_CLIENT_ID_AQUI

# 3. (Opcional) ID do Servidor Discord para comandos instantâneos:
DISCORD_GUILD_ID=

# 4. Credenciais do Banco Supabase (já configuradas):
SUPABASE_URL=https://isqjusvluobjooknybdu.supabase.co
SUPABASE_ANON_KEY=sb_publishable_4rVEwpMQgn9675svYG9Dzw_bl6iD5Zr

# 5. Link oficial do seu site no Render:
