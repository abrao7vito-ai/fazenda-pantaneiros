# ===================================================
# CONFIGURAÇÕES DO BOT DO DISCORD - FAZENDA PANTANEIROS
# Copie este arquivo para .env na pasta bot/ e preencha com as credenciais.
# ===================================================

# 1. Token do Bot do Discord (Portal de Desenvolvedores do Discord -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=SEU_DISCORD_BOT_TOKEN_AQUI

# 2. Application ID / Client ID (General Information)
DISCORD_CLIENT_ID=SEU_DISCORD_CLIENT_ID_AQUI

# 3. (Opcional) ID do Servidor Discord para registro de comandos instantâneos
DISCORD_GUILD_ID=

# 4. Credenciais do Banco Supabase
SUPABASE_URL=https://sua-instancia.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_aqui

# 5. URL da aplicação Web
APP_URL=https://sua-aplicacao.onrender.com
PORT=3001
